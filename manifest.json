{
  "manifest_version": 3,
  "name": "Open Tab Saver",
  "version": "2.3.1",
  "author": "Vikas Kumar Meena",
  "description": "Capture, find, export, and reopen your tab sessions.",
  "permissions": ["tabs", "storage", "alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Tab Saver",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
